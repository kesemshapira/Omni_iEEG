"""
Sliding-window correlation matrices.

data: (n_channels, n_samples)
overlap is a fraction. 0.5 means the next window starts halfway into the current one.
Output corr_mats is (n_windows, n_channels, n_channels), time on axis 0.
"""

import numpy as np


def safe_corrcoef(segment):
    """Pearson matrix of one window. NaN/inf -> 0, then force symmetry."""
    segment = np.asarray(segment, dtype=float)
    corr = np.atleast_2d(np.corrcoef(segment))
    corr = np.nan_to_num(corr, nan=0.0, posinf=0.0, neginf=0.0)
    corr = np.asarray(corr, dtype=np.float64)
    return 0.5 * (corr + corr.T)


def sliding_window_correlations(data, sfreq, window_sec, overlap, channel_names=None):
    """
    One correlation matrix per window.

    step = window_sec * (1 - overlap). For 0.5 s windows and overlap 0.5 the step is 0.25 s.
    """
    data = np.asarray(data, dtype=float)
    n_channels, n_samples = data.shape
    if channel_names is not None and len(channel_names) != n_channels:
        raise ValueError("channel_names length does not match data")

    window_samples = int(window_sec * sfreq)
    step_samples = int(window_samples * (1.0 - overlap))
    if window_samples < 2 or step_samples < 1:
        raise ValueError(
            "bad window/step: %s samples, step %s (sfreq=%s)"
            % (window_samples, step_samples, sfreq)
        )

    corr_mats = []
    starts = []
    start = 0
    while start + window_samples <= n_samples:
        segment = data[:, start : start + window_samples]
        corr_mats.append(safe_corrcoef(segment))
        starts.append(start)
        start += step_samples

    starts = np.asarray(starts, dtype=int)
    return {
        "corr_mats": np.asarray(corr_mats, dtype=np.float64),
        "start_sample": starts,
        "start_time": starts / float(sfreq),
        "window_sec": float(window_sec),
        "overlap": float(overlap),
        "sfreq": float(sfreq),
        "channel_names": None if channel_names is None else list(channel_names),
    }


def save_correlations(path, result):
    """Write the dict from sliding_window_correlations. Load corr_mats with np.load(path)['corr_mats']."""
    names = result["channel_names"] or []
    np.savez(
        path,
        corr_mats=result["corr_mats"],
        start_sample=result["start_sample"],
        start_time=result["start_time"],
        window_sec=result["window_sec"],
        overlap=result["overlap"],
        sfreq=result["sfreq"],
        channel_names=np.asarray(names),
    )


def correlations_from_edf(edf_path, window_sec, overlap, channel_names=None):
    """
    EDF -> sliding_window_correlations.
    channel_names picks a subset; None keeps every channel in the file.
    """
    import mne

    raw = mne.io.read_raw_edf(edf_path, preload=True, verbose=False)
    if channel_names is not None:
        raw.pick(list(channel_names))
    return sliding_window_correlations(
        raw.get_data(),
        raw.info["sfreq"],
        window_sec,
        overlap,
        channel_names=list(raw.ch_names),
    )
